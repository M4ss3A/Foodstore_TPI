# Conexion a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore_db

# Clave para firmar el JWT: al menos 32 caracteres.
# Para generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido en CORS
FRONTEND_ORIGIN=http://localhost:5173